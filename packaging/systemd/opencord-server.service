[Unit]
Description=OpenCord chat server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opencord
Group=opencord
WorkingDirectory=/opt/opencord-server
ExecStart=/opt/opencord-server/opencord-server start --config /etc/opencord/config.toml
Restart=on-failure
RestartSec=3
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/opencord /etc/opencord
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
